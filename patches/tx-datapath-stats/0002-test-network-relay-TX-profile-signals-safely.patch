From ecdf43d231a0cca63dc67db3a901c3ad193e5fc9 Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Tue, 29 Sep 2026 11:10:36 +0000
Subject: [PATCH] test(network): relay TX profile signals safely

---
 Sources/KrunVMMHelper/KrunVMMHelperMain.swift |  48 +++---
 Sources/KrunVMMIPC/KrunVMMIPC.c               | 144 ++++++++++++++++++
 Sources/KrunVMMIPC/include/KrunVMMIPC.h       |   5 +
 .../KrunVMMControlChannel.swift               |  35 +++++
 4 files changed, 215 insertions(+), 17 deletions(-)

diff --git a/Sources/KrunVMMHelper/KrunVMMHelperMain.swift b/Sources/KrunVMMHelper/KrunVMMHelperMain.swift
index 0f12e56..5b328c4 100644
--- a/Sources/KrunVMMHelper/KrunVMMHelperMain.swift
+++ b/Sources/KrunVMMHelper/KrunVMMHelperMain.swift
@@ -466,28 +466,42 @@ private func run(config: KrunVMMConfig, startedAt: ContinuousClock.Instant) thro
   terminationSource.resume()
 
   // Profiling is opt-in and signal-driven so normal VMM execution does not emit
-  // datapath logs. SIGUSR2 starts a fresh measurement window and SIGUSR1 emits
-  // one aggregate snapshot for each configured network.
-  signal(SIGUSR1, SIG_IGN)
-  signal(SIGUSR2, SIG_IGN)
+  // datapath logs. Relay the profiling signals through an async-signal-safe pipe
+  // instead of relying on DispatchSource signal delivery.
+  let txStatsSignalHandle = try KrunVMMControlChannel.installProfileSignalRelay(
+    snapshotSignal: SIGUSR1,
+    resetSignal: SIGUSR2
+  )
+  let txStatsSignalFD = txStatsSignalHandle.fileDescriptor
   let txStatsQueue = DispatchQueue(label: "com.github.robertderose.container-krun-runtime.tx-stats")
-  let txStatsSource = DispatchSource.makeSignalSource(signal: SIGUSR1, queue: txStatsQueue)
-  txStatsSource.setEventHandler {
-    emitTxDatapathStats(krun: krun, context: context, networkCount: config.networks.count)
-  }
-  txStatsSource.resume()
-  let txStatsResetSource = DispatchSource.makeSignalSource(signal: SIGUSR2, queue: txStatsQueue)
-  txStatsResetSource.setEventHandler {
-    resetTxDatapathStats(krun: krun, context: context, networkCount: config.networks.count)
+  txStatsQueue.async {
+    while true {
+      do {
+        guard let command = try KrunVMMControlChannel.receiveProfileSignal(from: txStatsSignalFD)
+        else {
+          return
+        }
+        switch command {
+        case .snapshot:
+          emitTxDatapathStats(krun: krun, context: context, networkCount: config.networks.count)
+        case .reset:
+          resetTxDatapathStats(krun: krun, context: context, networkCount: config.networks.count)
+        }
+      } catch {
+        HelperLifecycleTrace.mark(
+          startedAt: startedAt,
+          event: "TX datapath signal relay closed",
+          metadata: ["error": "\(error)"]
+        )
+        return
+      }
+    }
   }
-  txStatsResetSource.resume()
 
   defer {
-    txStatsResetSource.cancel()
-    txStatsSource.cancel()
+    try? KrunVMMControlChannel.uninstallProfileSignalRelay()
+    try? txStatsSignalHandle.close()
     terminationSource.cancel()
-    signal(SIGUSR2, SIG_DFL)
-    signal(SIGUSR1, SIG_DFL)
     signal(SIGTERM, SIG_DFL)
   }
 
diff --git a/Sources/KrunVMMIPC/KrunVMMIPC.c b/Sources/KrunVMMIPC/KrunVMMIPC.c
index 0fa3031..79eac37 100644
--- a/Sources/KrunVMMIPC/KrunVMMIPC.c
+++ b/Sources/KrunVMMIPC/KrunVMMIPC.c
@@ -3,6 +3,7 @@
 #include <arpa/inet.h>
 #include <errno.h>
 #include <fcntl.h>
+#include <signal.h>
 #include <stddef.h>
 #include <string.h>
 #include <sys/socket.h>
@@ -13,6 +14,43 @@ struct krun_vmm_request {
     uint32_t port;
 };
 
+#define KRUN_VMM_PROFILE_SIGNAL_SNAPSHOT 1
+#define KRUN_VMM_PROFILE_SIGNAL_RESET 2
+
+static volatile sig_atomic_t profile_signal_write_fd = -1;
+static volatile sig_atomic_t profile_snapshot_signal = 0;
+static volatile sig_atomic_t profile_reset_signal = 0;
+static struct sigaction profile_old_snapshot_action;
+static struct sigaction profile_old_reset_action;
+static int profile_signal_relay_installed = 0;
+
+static void profile_signal_handler(int signal_number) {
+    int saved_errno = errno;
+    uint8_t command = 0;
+    if (signal_number == profile_snapshot_signal) {
+        command = KRUN_VMM_PROFILE_SIGNAL_SNAPSHOT;
+    } else if (signal_number == profile_reset_signal) {
+        command = KRUN_VMM_PROFILE_SIGNAL_RESET;
+    }
+
+    int fd = profile_signal_write_fd;
+    if (fd >= 0 && command != 0) {
+        ssize_t result;
+        do {
+            result = write(fd, &command, sizeof(command));
+        } while (result < 0 && errno == EINTR);
+    }
+    errno = saved_errno;
+}
+
+static int set_nonblock(int fd) {
+    int flags = fcntl(fd, F_GETFL);
+    if (flags < 0) {
+        return -1;
+    }
+    return fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+}
+
 static int32_t neg_errno(void) {
     return errno == 0 ? -EIO : -errno;
 }
@@ -260,3 +298,109 @@ int32_t krun_vmm_ipc_recv_response(int32_t fd, int32_t *status, int32_t *passed_
     *passed_fd = received_fd;
     return 0;
 }
+
+int32_t krun_vmm_ipc_install_profile_signal_relay(
+    int32_t *read_fd, int32_t snapshot_signal, int32_t reset_signal
+) {
+    if (read_fd == NULL || snapshot_signal <= 0 || reset_signal <= 0 ||
+        snapshot_signal == reset_signal || profile_signal_relay_installed) {
+        return -EINVAL;
+    }
+
+    int descriptors[2] = {-1, -1};
+    if (pipe(descriptors) < 0) {
+        return neg_errno();
+    }
+    if (set_cloexec(descriptors[0]) < 0 || set_cloexec(descriptors[1]) < 0 ||
+        set_nonblock(descriptors[1]) < 0) {
+        int saved = errno;
+        close(descriptors[0]);
+        close(descriptors[1]);
+        errno = saved;
+        return neg_errno();
+    }
+
+    struct sigaction action;
+    memset(&action, 0, sizeof(action));
+    action.sa_handler = profile_signal_handler;
+    sigemptyset(&action.sa_mask);
+    action.sa_flags = SA_RESTART;
+
+    profile_signal_write_fd = descriptors[1];
+    profile_snapshot_signal = snapshot_signal;
+    profile_reset_signal = reset_signal;
+
+    if (sigaction(snapshot_signal, &action, &profile_old_snapshot_action) < 0) {
+        int saved = errno;
+        profile_signal_write_fd = -1;
+        profile_snapshot_signal = 0;
+        profile_reset_signal = 0;
+        close(descriptors[0]);
+        close(descriptors[1]);
+        errno = saved;
+        return neg_errno();
+    }
+    if (sigaction(reset_signal, &action, &profile_old_reset_action) < 0) {
+        int saved = errno;
+        sigaction(snapshot_signal, &profile_old_snapshot_action, NULL);
+        profile_signal_write_fd = -1;
+        profile_snapshot_signal = 0;
+        profile_reset_signal = 0;
+        close(descriptors[0]);
+        close(descriptors[1]);
+        errno = saved;
+        return neg_errno();
+    }
+
+    profile_signal_relay_installed = 1;
+    *read_fd = descriptors[0];
+    return 0;
+}
+
+int32_t krun_vmm_ipc_recv_profile_signal(int32_t fd, uint8_t *command) {
+    if (fd < 0 || command == NULL) {
+        return -EINVAL;
+    }
+    ssize_t result;
+    do {
+        result = read(fd, command, sizeof(*command));
+    } while (result < 0 && errno == EINTR);
+    if (result < 0) {
+        return neg_errno();
+    }
+    if (result == 0) {
+        return 0;
+    }
+    return result == (ssize_t)sizeof(*command) ? 1 : -EPROTO;
+}
+
+int32_t krun_vmm_ipc_uninstall_profile_signal_relay(void) {
+    if (!profile_signal_relay_installed) {
+        return 0;
+    }
+
+    int snapshot_signal = profile_snapshot_signal;
+    int reset_signal = profile_reset_signal;
+    int write_fd = profile_signal_write_fd;
+    int first_error = 0;
+
+    profile_signal_write_fd = -1;
+    profile_snapshot_signal = 0;
+    profile_reset_signal = 0;
+    profile_signal_relay_installed = 0;
+
+    if (sigaction(snapshot_signal, &profile_old_snapshot_action, NULL) < 0) {
+        first_error = errno;
+    }
+    if (sigaction(reset_signal, &profile_old_reset_action, NULL) < 0 && first_error == 0) {
+        first_error = errno;
+    }
+    if (write_fd >= 0 && close(write_fd) < 0 && first_error == 0) {
+        first_error = errno;
+    }
+    if (first_error != 0) {
+        errno = first_error;
+        return neg_errno();
+    }
+    return 0;
+}
diff --git a/Sources/KrunVMMIPC/include/KrunVMMIPC.h b/Sources/KrunVMMIPC/include/KrunVMMIPC.h
index a07afb8..1617c8a 100644
--- a/Sources/KrunVMMIPC/include/KrunVMMIPC.h
+++ b/Sources/KrunVMMIPC/include/KrunVMMIPC.h
@@ -12,6 +12,11 @@ int32_t krun_vmm_ipc_send_request(int32_t fd, uint32_t opcode, uint32_t port);
 int32_t krun_vmm_ipc_recv_request(int32_t fd, uint32_t *opcode, uint32_t *port);
 int32_t krun_vmm_ipc_send_response(int32_t fd, int32_t status, int32_t passed_fd);
 int32_t krun_vmm_ipc_recv_response(int32_t fd, int32_t *status, int32_t *passed_fd);
+int32_t krun_vmm_ipc_install_profile_signal_relay(
+    int32_t *read_fd, int32_t snapshot_signal, int32_t reset_signal
+);
+int32_t krun_vmm_ipc_recv_profile_signal(int32_t fd, uint8_t *command);
+int32_t krun_vmm_ipc_uninstall_profile_signal_relay(void);
 
 #ifdef __cplusplus
 }
diff --git a/Sources/KrunVMMProtocol/KrunVMMControlChannel.swift b/Sources/KrunVMMProtocol/KrunVMMControlChannel.swift
index 85e75e4..ee35bdc 100644
--- a/Sources/KrunVMMProtocol/KrunVMMControlChannel.swift
+++ b/Sources/KrunVMMProtocol/KrunVMMControlChannel.swift
@@ -1,6 +1,11 @@
 import Foundation
 import KrunVMMIPC
 
+public enum KrunVMMProfileSignalCommand: UInt8, Sendable, Equatable {
+  case snapshot = 1
+  case reset = 2
+}
+
 public enum KrunVMMControlRequest: Sendable, Equatable {
   case dial(port: UInt32)
 }
@@ -37,6 +42,36 @@ public enum KrunVMMControlChannel {
     )
   }
 
+  public static func installProfileSignalRelay(
+    snapshotSignal: Int32,
+    resetSignal: Int32
+  ) throws -> FileHandle {
+    var readFD: Int32 = -1
+    try check(
+      krun_vmm_ipc_install_profile_signal_relay(
+        &readFD, snapshotSignal, resetSignal
+      )
+    )
+    return FileHandle(fileDescriptor: readFD, closeOnDealloc: true)
+  }
+
+  public static func receiveProfileSignal(from fd: Int32) throws -> KrunVMMProfileSignalCommand? {
+    var raw: UInt8 = 0
+    let result = krun_vmm_ipc_recv_profile_signal(fd, &raw)
+    if result == 0 {
+      return nil
+    }
+    try check(result < 0 ? result : 0)
+    guard let command = KrunVMMProfileSignalCommand(rawValue: raw) else {
+      throw KrunVMMControlError.unknownOpcode(UInt32(raw))
+    }
+    return command
+  }
+
+  public static func uninstallProfileSignalRelay() throws {
+    try check(krun_vmm_ipc_uninstall_profile_signal_relay())
+  }
+
   public static func sendDialRequest(to fd: Int32, port: UInt32) throws {
     try check(krun_vmm_ipc_send_request(fd, dialOpcode, port))
   }
